{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDIAlyzer",
  "version": "0.1.0",
  "identifier": "org.openms.opendialyzer",
  "build": {
    "frontendDist": "../ui-tauri"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenDIAlyzer (Tauri port)",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
